<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ digest.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f2ef;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f2ef;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#fcfcfb;border-radius:8px;font-family:Georgia,'Times New Roman',serif;color:#0b0b0b;">
  <tr><td style="padding:28px 28px 8px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#52514e;">Daily regional digest &middot; {{ digest.day.strftime("%A %d %B %Y") }}</div>
    <h1 style="margin:6px 0 0;font-size:24px;line-height:1.25;font-weight:normal;">Security, politics &amp; economy</h1>
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#52514e;margin-top:6px;">
      {{ digest.article_count }} articles{% for region, articles in digest.sections %} &middot; <a href="#{{ region }}" style="color:#52514e;">{{ region | title }} ({{ articles | length }})</a>{% endfor %} &middot; {{ digest.datasets | length }} datasets
    </div>
  </td></tr>

  {% if not digest.sections %}
  <tr><td style="padding:16px 28px;font-size:15px;color:#52514e;">No articles passed the relevance threshold today.</td></tr>
  {% endif %}

  {% for region, articles in digest.sections %}
  <tr><td id="{{ region }}" style="padding:24px 28px 4px;">
    <h2 style="margin:0;padding-bottom:6px;border-bottom:2px solid #0b0b0b;font-family:Arial,Helvetica,sans-serif;font-size:14px;letter-spacing:.06em;text-transform:uppercase;">{{ region | title }}</h2>
  </td></tr>
  {% for article in articles %}
  <tr><td style="padding:14px 28px;border-bottom:1px solid #e4e3df;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#52514e;letter-spacing:.04em;text-transform:uppercase;">
      {{ article.source }}{% for topic in article.topics %} &middot; {{ topic }}{% endfor %}
    </div>
    <a href="{{ article.url }}" style="display:block;margin-top:4px;font-size:18px;line-height:1.3;color:#0b0b0b;text-decoration:none;font-weight:bold;">{{ article.title }}</a>
    <p style="margin:6px 0 0;font-size:15px;line-height:1.5;color:#2b2a28;">{{ article.paragraph }}</p>
    <a href="{{ article.url }}" style="display:inline-block;margin-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#2a78d6;">Read the article &rarr;</a>{% if article.from_feed_summary %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#8a8984;"> &middot; summary from feed</span>{% endif %}
  </td></tr>
  {% endfor %}
  {% endfor %}

  <tr><td style="padding:32px 28px 4px;">
    <h2 style="margin:0;padding-bottom:6px;border-bottom:2px solid #0b0b0b;font-family:Arial,Helvetica,sans-serif;font-size:14px;letter-spacing:.06em;text-transform:uppercase;">New datasets</h2>
  </td></tr>
  {% if not digest.datasets %}
  <tr><td style="padding:14px 28px;font-size:15px;color:#52514e;">No relevant datasets were released today.</td></tr>
  {% endif %}
  {% for dataset in digest.datasets %}
  <tr><td style="padding:14px 28px;border-bottom:1px solid #e4e3df;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#52514e;letter-spacing:.04em;text-transform:uppercase;">
      {{ dataset.publisher }} via {{ dataset.source }}{% for region in dataset.regions %} &middot; {{ region }}{% endfor %}{% for topic in dataset.topics %} &middot; {{ topic }}{% endfor %}
    </div>
    <a href="{{ dataset.url }}" style="display:block;margin-top:4px;font-size:17px;line-height:1.3;color:#0b0b0b;text-decoration:none;font-weight:bold;">{{ dataset.title }}</a>
    {% if dataset.chart_cid %}
    <img src="cid:{{ dataset.chart_cid }}" width="584" alt="Preliminary chart. {{ dataset.chart_caption }}" style="display:block;width:100%;max-width:584px;height:auto;margin-top:10px;border:0;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#52514e;margin-top:4px;">Preliminary chart, built automatically: {{ dataset.chart_caption }}</div>
    {% else %}
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#8a8984;margin-top:4px;">No chart: no downloadable table that could be plotted.</div>
    {% endif %}
    <a href="{{ dataset.url }}" style="display:inline-block;margin-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#2a78d6;">Open the dataset &rarr;</a>
  </td></tr>
  {% endfor %}

  {% if digest.failures %}
  <tr><td style="padding:24px 28px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#8a8984;">
    <strong>Sources that failed today</strong>
    <ul style="margin:6px 0 0;padding-left:18px;">
      {% for failure in digest.failures %}<li>{{ failure }}</li>{% endfor %}
    </ul>
  </td></tr>
  {% endif %}
  <tr><td style="padding:20px 28px 28px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#8a8984;">
    Keywords, sources and recipients are edited in the <code>config/</code> folder of the Regional News Aggregator repository.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
